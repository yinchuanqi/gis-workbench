{
  "name": "@focus-daima/gis-workbench",
  "version": "0.9.10",
  "type": "module",
  "main": "./index.js",
  "description": "MapLibre GIS workbench with PostGIS registration, semantic vector styling, GPKG import, COG rasters, and resumable uploads.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "shared.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src",
    "server",
    "style-schema.js",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "registry": "https://your-nexus-host/repository/frontend/",
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "maplibre-gl": "^5.24.1"
  }
}
